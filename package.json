{
  "name": "cafepos",
  "version": "0.0.0",
  "private": true,
  "description": "Offline-first multi-branch cafe and restaurant point-of-sale system",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dana-khaing/CafePOS.git"
  },
  "keywords": [
    "pos",
    "point-of-sale",
    "offline-first",
    "cafe",
    "restaurant",
    "nextjs",
    "turborepo"
  ],
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "turbo run lint",
    "release:check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm audit --audit-level high",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9",
      "find-my-way": "9.7.0",
      "postcss": "8.5.21",
      "sharp": "0.35.0",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.17",
      "fast-json-stringify>fast-uri": "4.1.2",
      "@fastify/ajv-compiler>fast-uri": "3.1.5"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "eslint": "9.30.1",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "turbo": "2.5.5",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.1"
  }
}
